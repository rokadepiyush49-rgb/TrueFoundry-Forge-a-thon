{
  "$comment": "Copy to config/models.local.json (git-ignored), put real keys there and set enabled: true on the providers you use, then run: npm run setup:models. Model ids match TrueForge's built-in catalog (Nov 2026). Gemini must use type google-gemini, not custom (TrueForge issue #1385: tool calls fail through custom providers). Keys stay in your local TrueForge; ForgePilot never calls a provider directly.",
  "trueforgeUrl": "http://localhost:8790",
  "providers": [
    {
      "enabled": false,
      "name": "anthropic",
      "type": "anthropic",
      "auth": {
        "apiKey": "YOUR_ANTHROPIC_API_KEY"
      },
      "models": [
        {
          "name": "claude-haiku-5-5",
          "modelId": "claude-haiku-5-5",
          "properties": {
            "contextLength": 1000000
          }
        }
      ]
    },
    {
      "enabled": false,
      "name": "openai",
      "type": "openai",
      "auth": {
        "apiKey": "YOUR_OPENAI_API_KEY"
      },
      "models": [
        {
          "name": "gpt-5-4-mini",
          "modelId": "gpt-5.4-mini",
          "properties": {
            "contextLength": 400000
          }
        }
      ]
    },
    {
      "enabled": false,
      "name": "gemini",
      "type": "google-gemini",
      "auth": {
        "apiKey": "YOUR_GEMINI_API_KEY"
