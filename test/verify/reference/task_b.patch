+def test_config_command_masks_secrets(runner):
+    app = Flask(__name__)
+    app.config.update(
+        SECRET_KEY="dev-secret",
+        DB_PASSWORD="hunter2",
+        API_TOKEN="token-value",
+        STRIPE_KEY="key-value",
+        GREETING="hello",
+    )
+    cli = FlaskGroup(create_app=lambda: app)
+    result = runner.invoke(cli, ["config"])
+    assert result.exit_code == 0, result.output
+    data = json.loads(result.output)
+    for key in ("SECRET_KEY", "DB_PASSWORD", "API_TOKEN", "STRIPE_KEY"):
+        assert data[key] == "***"
+    assert data["GREETING"] == "hello"
+    assert "hunter2" not in result.output
+    assert "PERMANENT_SESSION_LIFETIME" in data
+
+
+def test_config_command_in_help(runner):
+    cli = FlaskGroup(create_app=lambda: Flask(__name__))
+    result = runner.invoke(cli, ["--help"])
+    assert "config" in result.output
