+_SECRET_KEY_PARTS = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+
+@click.command("config", short_help="Show the app's configuration as JSON.")
+@with_appcontext
+def config_command() -> None:
+    """Show the loaded application's configuration as JSON. The values of
+    keys containing SECRET, PASSWORD, TOKEN or KEY are masked as ``"***"``.
+    """
+    config = {
+        key: (
+            "***"
+            if any(part in key.upper() for part in _SECRET_KEY_PARTS)
+            else value
+        )
+        for key, value in current_app.config.items()
+    }
+    click.echo(json.dumps(config, indent=2, sort_keys=True, default=str))
+
+
